---
import { Icon } from 'astro-icon/components';
import type { UIKey } from '../i18n/ui';

interface Props {
  t: (key: UIKey) => string;
}

const { t } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta">
      <h2>{t('cta.title')}</h2>
      <p>{t('cta.desc')}</p>
      <a class="btn btn-primary btn-lg" href="https://github.com/Siborne/easy-codegen" target="_blank" rel="noopener">
        <Icon name="lucide:arrow-right" />
        {t('cta.button')}
      </a>
    </div>
  </div>
</section>
