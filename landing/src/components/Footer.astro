---
import { Icon } from 'astro-icon/components';
import type { UIKey } from '../i18n/ui';

interface Props {
  t: (key: UIKey) => string;
}

const { t } = Astro.props;
const githubUrl = 'https://github.com/Siborne/easy-codegen';
---

<footer class="site-footer">
  <div class="container">
    <div>
      <strong>easy-codegen</strong> · {t('footer.license')} © {new Date().getFullYear()} {t('footer.rights')}
    </div>
    <div class="footer-links">
      <a href={githubUrl} target="_blank" rel="noopener">
        <Icon name="lucide:github" />
        GitHub
      </a>
      <a href="mailto:bo7785888@gmail.com">
        <Icon name="lucide:mail" />
        {t('footer.contact')}
      </a>
    </div>
  </div>
</footer>
