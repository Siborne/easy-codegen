---
import { Icon } from 'astro-icon/components';
import type { UIKey } from '../i18n/ui';
import { ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
  t: (key: UIKey) => string;
}

const { lang, t } = Astro.props;
const items = ui[lang]['quick.env.items'];
---

<section class="section" id="quickstart">
  <div class="container">
    <div class="section-head">
      <h2>{t('quick.title')}</h2>
      <p>{t('quick.subtitle')}</p>
    </div>

    <div class="quick-grid">
      <div class="quick-card featured">
        <h3>
          <Icon name="lucide:container" />
          {t('quick.docker.title')}
        </h3>
        <p>{t('quick.docker.desc')}</p>
        <pre class="code-block"><code>docker compose up -d --build</code></pre>
        <p class="quick-note">
          <Icon name="lucide:globe" />
          {t('quick.docker.note')}
        </p>
      </div>

      <div class="quick-card">
        <h3>
          <Icon name="lucide:terminal" />
          {t('quick.local.title')}
        </h3>
        <p>{t('quick.local.desc')}</p>

        <h3>
          <Icon name="lucide:check" />
          {t('quick.env')}
        </h3>
        <ul class="quick-list">
          {items.map((item) => (
            <li>
              <Icon name="lucide:check" />
              {item}
            </li>
          ))}
        </ul>

        <h3>
          <Icon name="lucide:terminal" />
          {t('quick.build')}
        </h3>
        <pre class="code-block"><code>cd easy-codegen <span class="cm">&amp;&amp;</span> mvn install -DskipTests
cd ../easy-codegen-web <span class="cm">&amp;&amp;</span> mvn install -DskipTests
cd ../easy-codegen-desktop <span class="cm">&amp;&amp;</span> mvn package -DskipTests</code></pre>

        <h3>
          <Icon name="lucide:refresh-cw" />
          {t('quick.dev')}
        </h3>
        <pre class="code-block"><code>cd easy-codegen-web/frontend
npm install
npm run dev <span class="cm"># http://localhost:6000</span></code></pre>

        <h3>
          <Icon name="lucide:rocket" />
          {t('quick.run.title')}
        </h3>
        <div class="run-row">
          <p>
            <strong>{t('quick.run.desktop')}</strong>
            <span>{t('quick.run.desktop.desc')}</span>
          </p>
          <pre class="code-block"><code>start-desktop.bat</code></pre>
        </div>
        <div class="run-row">
          <p>
            <strong>{t('quick.run.web')}</strong>
            <span>{t('quick.run.web.desc')}</span>
          </p>
          <pre class="code-block"><code>start-web.bat <span class="cm"># http://localhost:9000</span></code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .run-row {
    margin-top: 14px;
  }

  .run-row p {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0 0 10px;
    font-size: 0.93rem;
    color: var(--text-dim);
  }

  .run-row strong {
    color: var(--text);
    font-size: 0.98rem;
  }
</style>
