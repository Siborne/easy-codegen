---
import { Icon } from 'astro-icon/components';
import type { Lang, UIKey } from '../i18n/ui';
import { languages } from '../i18n/ui';

interface Props {
  lang: Lang;
  t: (key: UIKey) => string;
}

const { lang, t } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
// BASE_URL 可能是 '/easy-codegen' 或 '/easy-codegen/'，统一去掉尾斜杠再拼接
const base = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
const githubUrl = 'https://github.com/Siborne/easy-codegen';
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={`${base}/`}>
      <span class="brand-mark" aria-hidden="true"><Icon name="lucide:zap" /></span>
      easy-codegen
    </a>

    <nav class="nav-links" id="nav-links">
      <a href="#features">{t('nav.features')}</a>
      <a href="#how">{t('nav.how')}</a>
      <a href="#quickstart">{t('nav.quickstart')}</a>
      <a href="#modules">{t('nav.modules')}</a>
    </nav>

    <div class="nav-actions">
      <div class="lang-switch" role="group" aria-label="Language">
        {(Object.keys(languages) as Lang[]).map((l) => (
          <a href={`${base}/${l}/`} aria-current={l === lang ? 'true' : undefined}>
            {languages[l]}
          </a>
        ))}
      </div>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label={t('footer.theme')}>
        <Icon name="lucide:sun-moon" />
      </button>
      <a class="btn btn-ghost" href={githubUrl} target="_blank" rel="noopener">
        <Icon name="lucide:github" />
        {t('nav.source')}
      </a>
      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <Icon name="lucide:menu" />
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  links?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      links.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );

  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('ecg-theme', next);
    } catch (e) {
      /* ignore */
    }
  });
</script>
