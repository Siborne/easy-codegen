---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import QuickStart from '../../components/QuickStart.astro';
import Modules from '../../components/Modules.astro';
import CTA from '../../components/CTA.astro';
import { ui, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(ui) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang as Lang) ?? 'zh';
const t = (key: keyof (typeof ui)['zh']) => ui[lang][key];

const titles: Record<Lang, string> = {
  zh: 'easy-codegen — 可视化 Java 代码生成器',
  en: 'easy-codegen — Visual Java Code Generator',
};
const descriptions: Record<Lang, string> = {
  zh: '带可视化面板的 Java 代码生成器：读取数据库表结构，一键生成 PO、Query、Mapper、Service、Controller 全套代码。',
  en: 'A Java code generator with a visual panel: read your database schema and generate PO, Query, Mapper, Service and Controller code in one click.',
};
---

<BaseLayout lang={lang} title={titles[lang]} description={descriptions[lang]}>
  <Hero t={t} />
  <Features t={t} />
  <HowItWorks t={t} />
  <QuickStart lang={lang} t={t} />
  <Modules t={t} />
  <CTA t={t} />
</BaseLayout>
